# Example Environment Configuration
# Duplicate this file to .env and fill in your actual values

# Authentication Tokens
BIJI_BEARER_TOKEN=your_bearer_token_here
BIJI_REFRESH_TOKEN=your_refresh_token_here

# CSRF Protection
BIJI_CSRF_TOKEN=your_csrf_token_here
BIJI_COOKIE=csrfToken=your_csrf_token_here

# Browser Identification
BIJI_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36"
